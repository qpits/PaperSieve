# Copy to .env and fill in whichever keys your projects' embedding.api
# backend needs. Never commit the real .env file.

OPENAI_API_KEY=

# Required to fetch papers at all: OpenReview now blocks anonymous /notes
# requests with a bot-detection challenge, so a logged-in account is needed
# even for fully public venues. Use any registered OpenReview account.
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# Optional: only needed if embedding.local.model in a project's config is a
# gated/private Hugging Face model that requires an access token to download.
HF_TOKEN=
